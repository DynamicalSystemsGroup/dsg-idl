{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DynamicalSystemsGroup/dsg-idl/schema/dsg-registry-revocations-v1.json",
  "title": "dsg.registry.revocations/1",
  "$defs": {
    "snapshot": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "domain",
        "version",
        "issuedAt",
        "expiresAt",
        "previousSha256",
        "testOnly",
        "signerKey",
        "revoked",
        "trustHistory"
      ],
      "properties": {
        "domain": {
          "const": "dsg.registry.revocations/1",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "issuedAt": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "expiresAt": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "previousSha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "testOnly": {
          "const": true,
          "type": "boolean"
        },
        "signerKey": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "revoked": {
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": ["kind", "id", "effectiveAt", "reason"],
            "properties": {
              "kind": {
                "anyOf": [
                  {
                    "const": "principal",
                    "type": "string"
                  },
                  {
                    "const": "standing-order",
                    "type": "string"
                  },
                  {
                    "const": "law",
                    "type": "string"
                  },
                  {
                    "const": "class",
                    "type": "string"
                  },
                  {
                    "const": "key",
                    "type": "string"
                  }
                ]
              },
              "id": {
                "minLength": 1,
                "type": "string"
              },
              "effectiveAt": {
                "minimum": 0,
                "maximum": 9007199254740991,
                "type": "integer"
              },
              "reason": {
                "minLength": 1,
                "type": "string"
              }
            }
          }
        },
        "trustHistory": {
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "principal",
              "publicKey",
              "role",
              "action",
              "effectiveAt",
              "authoritySha256",
              "replacesKey"
            ],
            "properties": {
              "principal": {
                "minLength": 1,
                "type": "string"
              },
              "publicKey": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "role": {
                "anyOf": [
                  {
                    "const": "human",
                    "type": "string"
                  },
                  {
                    "const": "release",
                    "type": "string"
                  },
                  {
                    "const": "collector",
                    "type": "string"
                  }
                ]
              },
              "action": {
                "anyOf": [
                  {
                    "const": "enroll",
                    "type": "string"
                  },
                  {
                    "const": "rotate",
                    "type": "string"
                  },
                  {
                    "const": "compromise",
                    "type": "string"
                  }
                ]
              },
              "effectiveAt": {
                "minimum": 0,
                "maximum": 9007199254740991,
                "type": "integer"
              },
              "authoritySha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "replacesKey": {
                "anyOf": [
                  {
                    "pattern": "^[0-9a-f]{64}$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "pointer": {
      "additionalProperties": false,
      "type": "object",
      "required": ["version", "sha256", "url"],
      "properties": {
        "version": {
          "minimum": 1,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "url": {
          "pattern": "^/revocations/v/[1-9][0-9]*/snapshot\\.json$",
          "type": "string"
        }
      }
    }
  }
}
