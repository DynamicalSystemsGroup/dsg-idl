{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DynamicalSystemsGroup/dsg-idl/schema/dsg-kernel-ordinary-authority-v1.json",
  "title": "dsg.kernel.ordinary-authority/1",
  "$defs": {
    "authority": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "version",
        "reference",
        "actor",
        "publicKeyHex",
        "keyClass",
        "designation",
        "scope",
        "validity",
        "ceilings",
        "revoked"
      ],
      "properties": {
        "version": {
          "const": "dsg.kernel.ordinary-authority/1",
          "type": "string"
        },
        "reference": {
          "minLength": 1,
          "type": "string"
        },
        "actor": {
          "pattern": "^orn:[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*){3}:(?:[A-Za-z0-9\\-._~:/@]|%[0-9A-Fa-f]{2})+$",
          "type": "string"
        },
        "publicKeyHex": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "keyClass": {
          "anyOf": [
            {
              "const": "synthetic-test-only",
              "type": "string"
            },
            {
              "const": "human-authority",
              "type": "string"
            }
          ]
        },
        "designation": {
          "additionalProperties": false,
          "type": "object",
          "required": ["role", "designationReference"],
          "properties": {
            "role": {
              "const": "law-issuer",
              "type": "string"
            },
            "designationReference": {
              "minLength": 1,
              "type": "string"
            }
          }
        },
        "scope": {
          "additionalProperties": false,
          "type": "object",
          "required": ["scopeReference", "actions", "workloadClasses", "regions"],
          "properties": {
            "scopeReference": {
              "minLength": 1,
              "type": "string"
            },
            "actions": {
              "minItems": 1,
              "uniqueItems": true,
              "type": "array",
              "items": {
                "minLength": 1,
                "type": "string"
              }
            },
            "workloadClasses": {
              "minItems": 1,
              "uniqueItems": true,
              "type": "array",
              "items": {
                "minLength": 1,
                "type": "string"
              }
            },
            "regions": {
              "minItems": 1,
              "uniqueItems": true,
              "type": "array",
              "items": {
                "minLength": 1,
                "type": "string"
              }
            }
          }
        },
        "validity": {
          "additionalProperties": false,
          "type": "object",
          "required": ["notBefore", "notAfter"],
          "properties": {
            "notBefore": {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
              "type": "string"
            },
            "notAfter": {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
              "type": "string"
            }
          }
        },
        "ceilings": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "gpuSecondsPerPersonUtcWeek",
            "usdMicroUnitsPerPersonUtcMonth",
            "usdMicroUnitsPerOrganizationUtcMonth"
          ],
          "properties": {
            "gpuSecondsPerPersonUtcWeek": {
              "minimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "usdMicroUnitsPerPersonUtcMonth": {
              "minimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "usdMicroUnitsPerOrganizationUtcMonth": {
              "minimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            }
          }
        },
        "revoked": {
          "type": "boolean"
        }
      }
    }
  },
  "$ref": "#/$defs/authority"
}
