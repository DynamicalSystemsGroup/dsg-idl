{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DynamicalSystemsGroup/dsg-idl/schema/dsg-core-identity-binding-v1.json",
  "title": "dsg.core.identity-binding/1",
  "$defs": {
    "binding": {
      "additionalProperties": false,
      "type": "object",
      "required": ["profile", "principal", "issuer", "subject", "decider", "boundAt", "signature"],
      "properties": {
        "profile": {
          "const": "dsg.core.identity-binding/1",
          "type": "string"
        },
        "principal": {
          "pattern": "^orn:[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*){3}:(?:[A-Za-z0-9\\-._~:/@]|%[0-9A-Fa-f]{2})+$",
          "type": "string"
        },
        "issuer": {
          "const": "https://accounts.google.com",
          "type": "string"
        },
        "subject": {
          "minLength": 1,
          "type": "string"
        },
        "decider": {
          "pattern": "^orn:[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*){3}:(?:[A-Za-z0-9\\-._~:/@]|%[0-9A-Fa-f]{2})+$",
          "type": "string"
        },
        "boundAt": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "type": "string"
        },
        "signature": {
          "minLength": 1,
          "type": "string"
        }
      }
    }
  },
  "$ref": "#/$defs/binding"
}
