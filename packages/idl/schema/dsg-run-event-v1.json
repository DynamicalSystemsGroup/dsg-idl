{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DynamicalSystemsGroup/dsg-idl/schema/dsg-run-event-v1.json",
  "title": "dsg.run.event/1",
  "$defs": {
    "event": {
      "additionalProperties": false,
      "type": "object",
      "required": ["profile", "operation", "sequence", "at", "kind", "catalogSha256", "payload"],
      "properties": {
        "profile": {
          "const": "dsg.run.event/1",
          "type": "string"
        },
        "operation": {
          "minLength": 1,
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "at": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "type": "string"
        },
        "catalogSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "payload": {
          "type": "object",
          "patternProperties": {
            "^(.*)$": {}
          }
        }
      }
    },
    "streamSeal": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "profile",
        "operation",
        "catalogSha256",
        "streamSha256",
        "eventCount",
        "gaps",
        "truncatedAtSequence"
      ],
      "properties": {
        "profile": {
          "const": "dsg.run.event/1",
          "type": "string"
        },
        "operation": {
          "minLength": 1,
          "type": "string"
        },
        "catalogSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "streamSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "eventCount": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "gaps": {
          "type": "array",
          "items": {
            "minimum": 1,
            "maximum": 9007199254740991,
            "type": "integer"
          }
        },
        "truncatedAtSequence": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "$ref": "#/$defs/event"
}
