{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DynamicalSystemsGroup/dsg-idl/schema/dsg-run-workload-artifact-v1.json",
  "title": "dsg.run.workload-artifact/1",
  "$defs": {
    "workloadArtifact": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "profile",
        "schemaVersion",
        "kind",
        "id",
        "format",
        "source",
        "index",
        "executable",
        "entrypoint"
      ],
      "properties": {
        "profile": {
          "const": "dsg.run.workload-artifact/1",
          "type": "string"
        },
        "schemaVersion": {
          "const": 1,
          "type": "number"
        },
        "kind": {
          "const": "workload-artifact",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "format": {
          "const": "oci-image",
          "type": "string"
        },
        "source": {
          "additionalProperties": false,
          "type": "object",
          "required": ["repository", "revision", "sourceDigest"],
          "properties": {
            "repository": {
              "minLength": 1,
              "type": "string"
            },
            "revision": {
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
              "type": "string"
            },
            "sourceDigest": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          }
        },
        "index": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "additionalProperties": false,
              "type": "object",
              "required": ["sha256", "mediaType"],
              "properties": {
                "sha256": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                "mediaType": {
                  "anyOf": [
                    {
                      "const": "application/vnd.oci.image.index.v1+json",
                      "type": "string"
                    },
                    {
                      "const": "application/vnd.docker.distribution.manifest.list.v2+json",
                      "type": "string"
                    }
                  ]
                }
              }
            }
          ]
        },
        "executable": {
          "additionalProperties": false,
          "type": "object",
          "required": ["platform", "manifest", "config"],
          "properties": {
            "platform": {
              "additionalProperties": false,
              "type": "object",
              "required": ["os", "architecture"],
              "properties": {
                "os": {
                  "minLength": 1,
                  "type": "string"
                },
                "architecture": {
                  "minLength": 1,
                  "type": "string"
                },
                "variant": {
                  "minLength": 1,
                  "type": "string"
                }
              }
            },
            "manifest": {
              "additionalProperties": false,
              "type": "object",
              "required": ["sha256", "mediaType"],
              "properties": {
                "sha256": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                "mediaType": {
                  "anyOf": [
                    {
                      "const": "application/vnd.oci.image.manifest.v1+json",
                      "type": "string"
                    },
                    {
                      "const": "application/vnd.docker.distribution.manifest.v2+json",
                      "type": "string"
                    }
                  ]
                }
              }
            },
            "config": {
              "additionalProperties": false,
              "type": "object",
              "required": ["sha256", "mediaType"],
              "properties": {
                "sha256": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                "mediaType": {
                  "anyOf": [
                    {
                      "const": "application/vnd.oci.image.config.v1+json",
                      "type": "string"
                    },
                    {
                      "const": "application/vnd.docker.container.image.v1+json",
                      "type": "string"
                    }
                  ]
                }
              }
            }
          }
        },
        "entrypoint": {
          "minItems": 1,
          "type": "array",
          "items": {
            "minLength": 1,
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "profile",
        "schemaVersion",
        "kind",
        "artifact",
        "source",
        "build",
        "transportArchiveSha256",
        "observedAt",
        "evidence"
      ],
      "properties": {
        "profile": {
          "const": "dsg.run.workload-artifact/1",
          "type": "string"
        },
        "schemaVersion": {
          "const": 1,
          "type": "number"
        },
        "kind": {
          "const": "workload-artifact-provenance",
          "type": "string"
        },
        "artifact": {
          "additionalProperties": false,
          "type": "object",
          "required": ["orn", "sha256"],
          "properties": {
            "orn": {
              "pattern": "^orn:[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*){3}:(?:[A-Za-z0-9\\-._~:/@]|%[0-9A-Fa-f]{2})+$",
              "type": "string"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          }
        },
        "source": {
          "additionalProperties": false,
          "type": "object",
          "required": ["repository", "revision", "sourceDigest"],
          "properties": {
            "repository": {
              "minLength": 1,
              "type": "string"
            },
            "revision": {
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
              "type": "string"
            },
            "sourceDigest": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          }
        },
        "build": {
          "additionalProperties": false,
          "type": "object",
          "required": ["orn", "sha256"],
          "properties": {
            "orn": {
              "pattern": "^orn:[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*){3}:(?:[A-Za-z0-9\\-._~:/@]|%[0-9A-Fa-f]{2})+$",
              "type": "string"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          }
        },
        "transportArchiveSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "observedAt": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "type": "string"
        },
        "evidence": {
          "minItems": 1,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": ["orn", "sha256"],
            "properties": {
              "orn": {
                "pattern": "^orn:[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*){3}:(?:[A-Za-z0-9\\-._~:/@]|%[0-9A-Fa-f]{2})+$",
                "type": "string"
              },
              "sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "$ref": "#/$defs/workloadArtifact"
}
