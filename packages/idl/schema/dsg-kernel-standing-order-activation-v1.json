        "actor": {
          "pattern": "^orn:[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*){3}:(?:[A-Za-z0-9\\-._~:/@]|%[0-9A-Fa-f]{2})+$",
          "type": "string"
        },
        "mode": {
          "anyOf": [
            {
              "const": "synthetic-test-only",
              "type": "string"
            },
            {
              "const": "human-authority",
              "type": "string"
            }
          ]
        },
        "activatedAt": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "type": "string"
        }
      }
