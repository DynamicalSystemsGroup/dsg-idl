{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DynamicalSystemsGroup/dsg-idl/schema/dsg-kernel-standing-order-activation-v1.json",
  "title": "dsg.kernel.standing-order-activation/1",
  "$defs": {
    "activation": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "profile",
        "activationId",
        "expectedPreviousActivation",
        "law",
        "enrollment",
        "intent",
        "roots",
        "revocation",
        "actor",
        "mode",
        "activatedAt"
      ],
      "properties": {
        "profile": {
          "const": "dsg.kernel.standing-order-activation/1",
          "type": "string"
        },
        "activationId": {
          "pattern": "^orn:[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*){3}:(?:[A-Za-z0-9\\-._~:/@]|%[0-9A-Fa-f]{2})+$",
          "type": "string"
        },
        "expectedPreviousActivation": {
          "anyOf": [
            {
              "additionalProperties": false,
              "type": "object",
              "required": ["orn", "sha256"],
              "properties": {
                "orn": {
                  "pattern": "^orn:[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*){3}:(?:[A-Za-z0-9\\-._~:/@]|%[0-9A-Fa-f]{2})+$",
                  "type": "string"
                },
                "sha256": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "law": {
          "additionalProperties": false,
          "type": "object",
          "required": ["orn", "sha256"],
          "properties": {
            "orn": {
              "pattern": "^orn:[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*){3}:(?:[A-Za-z0-9\\-._~:/@]|%[0-9A-Fa-f]{2})+$",
              "type": "string"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          }
        },
        "enrollment": {
          "additionalProperties": false,
          "type": "object",
          "required": ["orn", "sha256"],
          "properties": {
