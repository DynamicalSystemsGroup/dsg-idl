              "required": ["orn", "sha256"],
              "properties": {
                "orn": {
                  "pattern": "^orn:[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*){3}:(?:[A-Za-z0-9\\-._~:/@]|%[0-9A-Fa-f]{2})+$",
                  "type": "string"
                },
                "sha256": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                }
              }
            },
            "actor": {
              "pattern": "^orn:[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*){3}:(?:[A-Za-z0-9\\-._~:/@]|%[0-9A-Fa-f]{2})+$",
              "type": "string"
            },
            "mode": {
              "anyOf": [
                {
                  "const": "synthetic-test-only",
                  "type": "string"
                },
                {
                  "const": "human-authority",
                  "type": "string"
                }
              ]
            },
            "activatedAt": {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
              "type": "string"
            }
          }
        },
        "signer": {
          "pattern": "^orn:[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*){3}:(?:[A-Za-z0-9\\-._~:/@]|%[0-9A-Fa-f]{2})+$",
          "type": "string"
        },
        "signature": {
          "pattern": "^[0-9a-f]{128}$",
          "type": "string"
        }
      }
    },
    "event": {
      "additionalProperties": false,
      "type": "object",
      "required": ["profile", "kind", "stream", "activation"],
      "properties": {
        "profile": {
          "const": "dsg.kernel.standing-order-activation/1",
          "type": "string"
        },
        "kind": {
          "const": "standing_order_activated",
          "type": "string"
        },
        "stream": {
          "pattern": "^orn:[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*){3}:(?:[A-Za-z0-9\\-._~:/@]|%[0-9A-Fa-f]{2})+$",
          "type": "string"
        },
        "activation": {
          "additionalProperties": false,
          "type": "object",
          "required": ["orn", "sha256"],
          "properties": {
            "orn": {
              "pattern": "^orn:[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*){3}:(?:[A-Za-z0-9\\-._~:/@]|%[0-9A-Fa-f]{2})+$",
