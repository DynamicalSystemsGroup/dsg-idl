{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dynamicalsystemsgroup.com/schemas/dsg-infra-resource-descriptor-1.json",
  "title": "DSG provider-neutral resource descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "workloadClass",
    "lifecycle",
    "machineType",
    "accelerator",
    "acceleratorCount",
    "vcpuCount",
    "memoryGiB",
    "maxRunSeconds",
    "maxParallelism",
    "region",
    "imageDigest",
    "moduleDigest",
    "externalIp",
    "network",
    "reservation"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "dsg.infra.resource-descriptor" },
    "workloadClass": { "type": "string", "minLength": 1 },
    "lifecycle": { "type": "string", "enum": ["ephemeral", "durable"] },
    "machineType": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*-[a-z0-9]+-[0-9]+$"
    },
    "accelerator": { "type": ["string", "null"], "minLength": 1 },
    "acceleratorCount": { "type": "integer", "minimum": 0 },
    "vcpuCount": { "type": "integer", "minimum": 1 },
    "memoryGiB": { "type": "integer", "minimum": 1 },
    "maxRunSeconds": { "type": "integer", "minimum": 1 },
    "maxParallelism": { "type": "integer", "minimum": 1 },
    "region": { "type": "string", "minLength": 1 },
    "imageDigest": { "pattern": "^sha256:[0-9a-f]{64}$", "type": "string" },
    "moduleDigest": { "pattern": "^sha256:[0-9a-f]{64}$", "type": "string" },
    "externalIp": { "const": false },
    "network": { "const": "private" },
    "reservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gpuSeconds", "usdMicroUnits"],
      "properties": {
        "gpuSeconds": { "type": "integer", "minimum": 0 },
        "usdMicroUnits": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
